# Content Studio — environment variables
# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
DATABASE_URL=sqlite:///./storage/content_studio.db
# Optional simple password gate if ever accessed over a private network (leave blank to disable)
LOCAL_ACCESS_PASSWORD=

# --- Gemini (Article + Discovery topic generation) ---
GEMINI_API_KEY=
# Text model for prompts/topics/scripts (default shown; also used for web-grounded prompt research)
GEMINI_TEXT_MODEL=gemini-3.7-flash
# Optional cheaper/faster model for simple extraction (Discovery topic generation). Blank = use GEMINI_TEXT_MODEL.
GEMINI_FAST_MODEL=
# Discovery: scrape feeds and generate topics in the background every N minutes (0 = off).
# Only useful on an always-on host; each run that finds new items costs a small Gemini call.
AUTO_SCRAPE_MINUTES=0

# --- Video generation (prompt -> mp4). Veo uses GEMINI_API_KEY above; it is PAID ONLY (no free tier). ---
# Higgsfield platform API (separate prepaid balance; create a key at console.higgsfield.ai)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Muapi.ai hosted API (paid, credit-based)
MUAPI_API_KEY=

# --- Video Studio engines (motion graphics, stock-footage shorts; see docs/10_Video_Studio_Engines.md) ---
# Pexels: free stock video search (https://www.pexels.com/api/). Required by the "faceless" engine.
PEXELS_API_KEY=
# Pixabay: optional second stock source
PIXABAY_API_KEY=
# Gemini speech model (Gemini TTS voices, e.g. Kore) and image model (scene stills / character sheets).
# Edge TTS (free, no key) is the default voice provider.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# --- Instagram Graph API (Dashboard analytics + Posts publishing) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_PAGE_ID=
# graph.facebook.com for Facebook-Login tokens (EAA...); graph.instagram.com for Instagram-Login tokens (IGAA..., auto-refreshed)
IG_GRAPH_BASE=https://graph.facebook.com/v21.0

# --- X / Twitter API (Discovery source + Dashboard analytics + post suggestions) ---
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Cloudinary (public media hosting required by Instagram publish API) ---
CLOUDINARY_URL=

# --- Getty (internal-use image sourcing — accepted risk, do not expose externally) ---
# Subject-cutout model for Posts "background removed" (rembg). Default u2net (cached locally, best quality/speed
# tradeoff measured); alternatives: silueta (smaller/faster download), isnet-general-use (slower), u2netp (tiny, rougher).
REMBG_MODEL=u2net
GETTY_USERNAME=
GETTY_PASSWORD=

# --- Cost awareness (optional) ---
# JSON map of price id -> usd overriding the built-in price table, e.g. {"gemini.image.out": 0.08}
PRICE_OVERRIDES_JSON=

# Preload the background-removal model at startup (auto-skipped on hosts with <1.5 GB RAM)
WARM_CUTOUT=true

# Footonomy admin integration (Footonomy tab). The token must equal ADMIN_TOKEN on the Footonomy backend.
# Use the app's private admin port; it is never exposed publicly. Leave the token empty to switch the tab off.
FOOTONOMY_ADMIN_URL=http://127.0.0.1:8082
FOOTONOMY_ADMIN_TOKEN=
